---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import CollectionItemCard from '../../components/CollectionItemCard.astro';
import Layout from '../../layouts/Layout.astro';
import {
	collectionCategories,
	getCollectionCategory,
	getCollectionCategoryHref,
} from '../../data/collectionCategories';
import { getCollectionAsset } from '../../lib/collectionAssets';
import { isContentEnabled } from '../../lib/contentVisibility';

const collectionEntries = (await getCollection('collections')).filter(isContentEnabled).sort(
	(left, right) => right.data.acquiredAt.valueOf() - left.data.acquiredAt.valueOf(),
);

const featuredEntries = collectionEntries.filter((item) => item.data.featured);
const heroEntries = featuredEntries.length ? featuredEntries : collectionEntries;

const resolveMediaSource = (source?: string) => {
	if (!source) return undefined;
	if (source.startsWith('asset:')) return getCollectionAsset(source.slice(6)).src;
	return source;
};
---

<Layout webTitle="MOEGN - 收藏室">
	<main>
		<section class="collection-hero" data-collection-hero aria-label="收藏随机轮播">
			{heroEntries.map((item, index) => {
				const category = getCollectionCategory(item.data.category);
				const media = item.data.heroMedia;
				const image = getCollectionAsset(item.data.imageKey);
				const mediaSource = resolveMediaSource(media?.src);
				const posterSource = resolveMediaSource(media?.poster);

				return (
					<article
						class:list={['collection-hero-slide', category ? `is-${category.tone}` : null, { 'is-active': index === 0 }]}
						data-collection-slide
						data-slide-index={index}
						style={`--hero-accent: ${category?.accent ?? '#ff69b4'}; --hero-soft: ${category?.softAccent ?? '#ffe6fa'}; --hero-background: ${category?.background ?? '#181518'}; --hero-background-alt: ${category?.backgroundAlt ?? '#33202a'}; --hero-foreground: ${category?.foreground ?? '#ffffff'}; --hero-muted: ${category?.muted ?? '#c8bfc4'}; --hero-signal: ${category?.signal ?? '#ff69b4'}; --hero-grid: ${category?.grid ?? '#ffffff'};`}
						aria-hidden={index === 0 ? 'false' : 'true'}
					>
						<div class="hero-backdrop" aria-hidden="true">
							{media?.type === 'video' && mediaSource ? (
								<video
									src={mediaSource}
									poster={posterSource}
									style={`object-position: ${media.position};`}
									muted
									loop
									playsinline
									preload="metadata"
									data-hero-video
								></video>
							) : media?.type === 'image' && mediaSource ? (
								<img src={mediaSource} alt="" style={`object-position: ${media.position};`} />
							) : null}
							<div class="hero-glitch-code">
								<span>0x{String(index + 1).padStart(2, '0')} / {category?.index ?? '00'} / FRAME_SYNC</span>
								<span>{item.data.itemType === 'virtual' ? 'DIGITAL_OBJECT' : 'PHYSICAL_OBJECT'} :: {item.data.category}</span>
								<span>ARCHIVE_READ // MOEGN_COLLECTION</span>
							</div>
						</div>
						<div class="hero-grid" aria-hidden="true"></div>
						<div class="hero-motion-type" aria-hidden="true">
							<p class="motion-code"><span>ARCHIVE SIGNAL</span><b>{category?.index ?? '00'} / {item.data.itemType === 'virtual' ? 'DIGITAL' : 'PHYSICAL'}</b></p>
							<div class="motion-row is-primary">
								<div class="motion-track">
									{[0, 1].map(() => <span>{item.data.subTitle} · {category?.title} · MOEGN PRIVATE COLLECTION · </span>)}
								</div>
							</div>
							<div class="motion-row is-secondary">
								<div class="motion-track">
									{[0, 1].map(() => <span>{item.data.tags.join(' / ')} / {item.data.title} / MASTER ARCHIVE / </span>)}
								</div>
							</div>
							<span class="motion-rule"></span>
						</div>
						<div class="hero-inner">
							<p class="hero-eyebrow"><span>MOEGN COLLECTION</span><b>{category?.index ?? '00'}</b></p>
							<div class="hero-copy-stack">
								<h1 class="hero-title">{item.data.title}</h1>
								<div class="hero-meta-stack">
									<div class="hero-tags" aria-label="收藏标签">
										<span>{item.data.itemType === 'virtual' ? '虚拟藏品' : '实体收藏'}</span>
										{item.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
									</div>
									<div class="hero-info-panel">
										<p class="hero-subtitle">{item.data.subTitle}</p>
										<p class="hero-summary">{item.data.summary}</p>
										<a class="hero-link" href={`/collections/${item.slug}/`}>
											<span>查看收藏文章</span><b aria-hidden="true">↗</b>
										</a>
									</div>
								</div>
							</div>
							<div class="hero-object">
								<span class="hero-object-halo" aria-hidden="true"></span>
								<Image src={image} alt={item.data.title} loading={index === 0 ? 'eager' : 'lazy'} />
								<span class="hero-object-caption"><b>{category?.title}</b><small>{item.data.edition ?? 'MOEGN ARCHIVE'}</small></span>
							</div>
						</div>
					</article>
				);
			})}

			<div class="hero-controls">
				<button type="button" data-hero-prev aria-label="上一件收藏">←</button>
				<div class="hero-progress" aria-hidden="true"><i data-hero-progress></i></div>
				<span><b data-hero-current>01</b> / {String(heroEntries.length).padStart(2, '0')}</span>
				<button type="button" data-hero-next aria-label="下一件收藏">→</button>
			</div>
			<a class="hero-scroll" href="#collection-categories" aria-label="向下滚动至收藏分类">
				<span class="scroll-mouse" aria-hidden="true"><i></i></span>
				<span class="scroll-label"><b>SCROLL</b><small>继续探索</small></span>
			</a>
		</section>

		<section class="collection-categories" id="collection-categories" aria-labelledby="category-title">
			<div class="section-heading">
				<p>Curated Chapters</p>
				<h2 id="category-title">收藏分类</h2>
				<span>每一类收藏都有自己的陈列方式与独立档案。</span>
			</div>
			<div class="category-grid">
				{collectionCategories.map((category, index) => {
					const categoryItems = collectionEntries.filter((item) => item.data.category === category.slug);
					const previewItem = categoryItems[0];
					const previewImage = previewItem ? getCollectionAsset(previewItem.data.imageKey) : null;

					return (
						<a
							class:list={['category-card', `is-${category.tone}`]}
							href={getCollectionCategoryHref(category.slug)}
							style={`--category-accent: ${category.accent}; --category-soft: ${category.softAccent}; --category-background: ${category.background}; --category-background-alt: ${category.backgroundAlt}; --category-foreground: ${category.foreground}; --category-muted: ${category.muted}; --category-signal: ${category.signal}; --category-grid: ${category.grid};`}
						>
							<span class="category-number">{category.index}</span>
							<span class="category-copy">
								<small>{category.englishTitle}</small>
								<strong>{category.title}</strong>
								<span>{category.description}</span>
							</span>
							{previewImage ? <Image src={previewImage} alt="" loading={index === 0 ? 'eager' : 'lazy'} /> : null}
							<b class="category-count">{String(categoryItems.length).padStart(2, '0')} ITEMS</b>
							<i aria-hidden="true">↗</i>
						</a>
					);
				})}
			</div>
		</section>

		<section class="all-collections" aria-labelledby="all-collections-title">
			<div class="section-heading is-row">
				<div>
					<p>The Complete Cabinet</p>
					<h2 id="all-collections-title">全部收藏</h2>
				</div>
				<span>共 {collectionEntries.length} 件记录</span>
			</div>
			<ul class="collection-list" role="list">
				{collectionEntries.map((item) => <li><CollectionItemCard item={item} /></li>)}
			</ul>
		</section>
	</main>
</Layout>

<style>
	main {
		overflow: hidden;
	}

	.collection-hero {
		position: relative;
		height: 100vh;
		height: 100svh;
		min-height: 760px;
		overflow: hidden;
		background: #eef0f2;
	}

	.collection-hero-slide {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(135deg, rgba(255,255,255,.98), rgba(248,249,250,.96)),
			#fff;
		opacity: 0;
		visibility: hidden;
		z-index: 0;
		transition: opacity .16s linear, visibility 0s linear .9s;
	}

	.collection-hero-slide.is-active {
		opacity: 1;
		visibility: visible;
		z-index: 1;
		transition: opacity .08s linear, visibility 0s;
	}

	.hero-backdrop,
	.hero-grid {
		position: absolute;
		top: 86px;
		left: max(20px, calc((100vw - 1500px) / 2 + 20px));
		right: max(20px, calc((100vw - 1500px) / 2 + 20px));
		height: calc(100% - 158px);
		min-height: 560px;
		clip-path: polygon(49% 0, 100% 0, 100% 100%, 14% 100%);
	}

	.hero-backdrop {
		overflow: hidden;
		isolation: isolate;
		background:
			radial-gradient(circle at 65% 42%, color-mix(in srgb, var(--hero-accent) 56%, transparent), transparent 48%),
			linear-gradient(110deg, var(--hero-background) 18%, var(--hero-background-alt) 100%);
		filter: drop-shadow(-18px 28px 34px rgba(20, 24, 30, .16));
	}

	.hero-backdrop::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 3;
		background:
			linear-gradient(90deg, transparent 0 12%, color-mix(in srgb, var(--hero-signal) 42%, transparent) 12% 31%, transparent 31% 100%),
			repeating-linear-gradient(180deg, transparent 0 13px, rgba(255,255,255,.12) 13px 14px);
		mix-blend-mode: screen;
		opacity: 0;
		pointer-events: none;
	}

	.hero-backdrop::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(4,8,12,.02), rgba(4,8,12,.16)),
			linear-gradient(90deg, color-mix(in srgb, var(--hero-background) 26%, transparent), transparent 62%);
		z-index: 1;
	}

	.hero-backdrop img,
	.hero-backdrop video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: .42;
		filter: saturate(.82) contrast(1.05);
	}

	.hero-glitch-code {
		position: absolute;
		top: 9%;
		right: 5%;
		z-index: 4;
		display: grid;
		gap: 5px;
		padding: 9px 12px;
		border-left: 1px solid var(--hero-signal);
		background: color-mix(in srgb, var(--hero-background) 80%, transparent);
		color: var(--hero-foreground);
		font-size: 8px;
		font-family: monospace;
		letter-spacing: 1.2px;
		line-height: 1.2;
		opacity: 0;
		pointer-events: none;
	}

	.hero-glitch-code span:nth-child(2) {
		color: var(--hero-signal);
	}

	.collection-hero-slide.is-active .hero-backdrop::before {
		animation: hero-glitch-scan .84s steps(1, end) both;
	}

	.collection-hero-slide.is-active .hero-backdrop img,
	.collection-hero-slide.is-active .hero-backdrop video {
		animation: hero-glitch-media .84s steps(1, end) both;
	}

	.collection-hero-slide.is-active .hero-glitch-code {
		animation: hero-glitch-code .84s steps(1, end) both;
	}

	.hero-eyebrow,
	.hero-motion-type,
	.hero-title,
	.hero-tags,
	.hero-info-panel,
	.hero-object,
	.hero-object-caption {
		opacity: 0;
	}

	.collection-hero-slide.is-active .hero-eyebrow {
		animation: module-chip-in .52s cubic-bezier(.2,.8,.2,1) .12s both;
	}

	.collection-hero-slide.is-active .hero-motion-type {
		animation: module-archive-in .65s ease-out .18s both;
	}

	.collection-hero-slide.is-active .hero-title {
		animation: module-title-in .68s cubic-bezier(.16,.84,.24,1) .24s both;
	}

	.collection-hero-slide.is-active .hero-tags {
		animation: module-tags-in .48s cubic-bezier(.2,.8,.2,1) .34s both;
	}

	.collection-hero-slide.is-active .hero-info-panel {
		animation: module-info-in .58s cubic-bezier(.2,.8,.2,1) .4s both;
	}

	.collection-hero-slide.is-active .hero-object {
		animation: module-object-in .76s cubic-bezier(.16,.84,.24,1) .12s both;
	}

	.collection-hero-slide.is-active .hero-object-caption {
		animation: module-caption-in .42s ease-out .5s both;
	}

	.hero-grid {
		opacity: .12;
		background-image:
			linear-gradient(var(--hero-grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--hero-grid) 1px, transparent 1px);
		background-size: 72px 72px;
		mask-image: linear-gradient(90deg, rgba(0,0,0,.45), #000 48%, transparent 100%);
		pointer-events: none;
	}

	.hero-motion-type {
		position: absolute;
		top: 145px;
		left: max(20px, calc((100vw - 1500px) / 2 + 20px));
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 18px;
		width: min(47vw, 730px);
		height: min(34vh, 320px);
		overflow: hidden;
		color: var(--hero-accent);
		mask-image: linear-gradient(90deg, transparent, #000 5%, #000 78%, transparent 100%);
		pointer-events: none;
	}

	.motion-code {
		display: flex;
		align-items: center;
		gap: 14px;
		margin: 0 0 3px 5%;
		font-size: 9px;
		font-family: var(--font-medium);
		letter-spacing: 2px;
		line-height: 1;
		opacity: .46;
	}

	.motion-code::before {
		content: '';
		width: 42px;
		height: 1px;
		background: currentColor;
	}

	.motion-code b {
		font-family: var(--font-heavy);
		opacity: .72;
	}

	.motion-row {
		width: 100%;
		overflow: hidden;
		white-space: nowrap;
	}

	.motion-track {
		display: flex;
		width: max-content;
		will-change: transform;
		animation: archive-scroll-left 30s linear infinite;
	}

	.motion-track span {
		display: block;
		padding-right: 4rem;
	}

	.motion-row.is-primary {
		font-size: clamp(1.25rem, 2.2vw, 2.35rem);
		font-family: var(--font-heavy);
		letter-spacing: -.02em;
		line-height: 1;
		opacity: .12;
	}

	.motion-row.is-secondary {
		font-size: 10px;
		font-family: var(--font-medium);
		letter-spacing: 2.5px;
		line-height: 1;
		opacity: .34;
	}

	.motion-row.is-secondary .motion-track {
		animation-name: archive-scroll-right;
		animation-duration: 22s;
	}

	.motion-rule {
		width: 72%;
		height: 1px;
		margin-left: 5%;
		background: linear-gradient(90deg, currentColor, transparent);
		opacity: .18;
	}

	.hero-inner {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		grid-template-rows: repeat(12, minmax(0, 1fr));
		gap: 12px 18px;
		width: min(1500px, 100%);
		height: 100%;
		margin: 0 auto;
		padding: 102px 20px 72px;
	}

	.hero-eyebrow {
		position: relative;
		z-index: 6;
		display: flex;
		align-items: center;
		align-self: start;
		grid-column: 1 / span 4;
		grid-row: 1 / span 1;
		gap: 16px;
		width: fit-content;
		min-height: 38px;
		margin: 0;
		padding: 0 18px 0 10px;
		background: color-mix(in srgb, var(--hero-background) 94%, black);
		box-shadow: 14px 0 28px color-mix(in srgb, var(--hero-accent) 16%, transparent) inset;
		color: var(--hero-foreground);
		font-size: 10px;
		font-family: var(--font-medium);
		letter-spacing: 2.4px;
		line-height: 1;
		clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);
	}

	.hero-eyebrow::before {
		content: '';
		width: 38px;
		height: 1px;
		background: var(--hero-accent);
	}

	.hero-eyebrow b {
		color: var(--hero-accent);
		font-family: var(--font-heavy);
	}

	.hero-copy-stack {
		position: relative;
		z-index: 7;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		align-self: end;
		grid-column: 1 / span 7;
		grid-row: 4 / span 9;
		gap: 12px;
		min-width: 0;
		--hero-optical-indent: clamp(12px, 1.1vw, 18px);
	}

	.hero-meta-stack {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 12px;
		width: 100%;
		transform: translateY(var(--hero-meta-drop, 0px));
	}

	.hero-info-panel {
		position: relative;
		z-index: 7;
		align-self: flex-start;
		width: min(550px, calc(100% - var(--hero-optical-indent)));
		margin-left: var(--hero-optical-indent);
		padding: 12px 48px 11px 20px;
		overflow: hidden;
		border: 0;
		background: linear-gradient(105deg, #fff 0 74%, rgba(255,255,255,.86) 100%);
		box-shadow: none;
		color: #171a1f;
		clip-path: polygon(0 0, 100% 0, calc(100% - var(--info-slope-shift, 72px)) 100%, 0 100%);
	}

	.hero-info-panel::before {
		content: '';
		position: absolute;
		top: 10px;
		bottom: 10px;
		left: 0;
		width: 2px;
		background: color-mix(in srgb, var(--hero-accent) 72%, transparent);
	}

	.hero-info-panel::after {
		content: '';
		position: absolute;
		top: 0;
		right: 0;
		width: 24%;
		height: 1px;
		background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--hero-accent) 44%, transparent));
	}

	.hero-subtitle {
		position: relative;
		z-index: 1;
		margin: 0;
		color: var(--hero-accent);
		font-size: 10px;
		font-family: var(--font-heavy);
		letter-spacing: 1.5px;
		line-height: 1.4;
	}

	.hero-summary {
		position: relative;
		z-index: 1;
		max-width: 480px;
		margin: 6px 0 0;
		color: #454b54;
		font-size: 12px;
		font-family: var(--font-light);
		line-height: 1.55;
	}

	.hero-link {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 24px;
		margin-top: 8px;
		padding: 0 0 4px;
		border-bottom: 1px solid var(--hero-accent);
		color: #171a1f;
		font-size: 10px;
		font-family: var(--font-medium);
		text-decoration: none;
		transition: gap .25s ease, color .25s ease;
	}

	.hero-link:hover,
	.hero-link:focus-visible {
		gap: 48px;
		color: var(--hero-accent);
	}

	.hero-tags {
		position: relative;
		z-index: 8;
		display: flex;
		flex-wrap: wrap;
		align-self: flex-start;
		gap: 8px;
		max-width: calc(100% - var(--hero-optical-indent));
		margin: 0 0 0 var(--hero-optical-indent);
	}

	.hero-tags span {
		padding: 6px 12px;
		border: 1px solid #c8ccd1;
		border-radius: 999px;
		background: rgba(255,255,255,.9);
		color: #2d3035;
		font-size: 11px;
		font-family: var(--font-light);
		line-height: 1;
		backdrop-filter: blur(8px);
	}

	.hero-title {
		position: relative;
		z-index: 9;
		align-self: stretch;
		width: 100%;
		max-width: 900px;
		margin: -.12em 0;
		padding: .12em 0;
		background: none;
		color: var(--hero-accent);
		font-size: clamp(5rem, 8.6vw, 9.5rem);
		font-family: var(--font-heavy);
		letter-spacing: -.1em;
		line-height: .82;
		text-wrap: balance;
		-webkit-text-fill-color: var(--hero-accent);
	}

	.hero-title.is-mask-ready {
		background-image: linear-gradient(
			var(--title-mask-angle, 118deg),
			var(--hero-accent) 0,
			var(--hero-accent) calc(var(--title-mask-stop, 42%) - .08%),
			#fff calc(var(--title-mask-stop, 42%) + .08%),
			#fff 100%
		);
		background-clip: text;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.collection-hero.is-initializing .collection-hero-slide {
		transition: none;
	}

	.collection-hero.is-initializing .collection-hero-slide.is-active .hero-eyebrow,
	.collection-hero.is-initializing .collection-hero-slide.is-active .hero-motion-type,
	.collection-hero.is-initializing .collection-hero-slide.is-active .hero-title,
	.collection-hero.is-initializing .collection-hero-slide.is-active .hero-tags,
	.collection-hero.is-initializing .collection-hero-slide.is-active .hero-info-panel,
	.collection-hero.is-initializing .collection-hero-slide.is-active .hero-object,
	.collection-hero.is-initializing .collection-hero-slide.is-active .hero-object-caption {
		animation: none;
		opacity: 0;
	}

	.collection-hero.is-initializing .collection-hero-slide.is-active .hero-backdrop::before,
	.collection-hero.is-initializing .collection-hero-slide.is-active .hero-backdrop img,
	.collection-hero.is-initializing .collection-hero-slide.is-active .hero-backdrop video,
	.collection-hero.is-initializing .collection-hero-slide.is-active .hero-glitch-code {
		animation: none;
	}

	.hero-object {
		position: relative;
		z-index: 4;
		display: grid;
		place-items: center;
		grid-column: 7 / span 6;
		grid-row: 1 / span 11;
		min-height: 0;
		padding: 18px 16px 40px;
	}

	.hero-object-halo {
		position: absolute;
		z-index: 0;
		width: min(34vw, 520px);
		aspect-ratio: 1;
		border: 1px dashed color-mix(in srgb, var(--hero-accent) 54%, transparent);
		border-radius: 50%;
		box-shadow:
			0 0 0 38px color-mix(in srgb, var(--hero-accent) 7%, transparent),
			0 0 0 78px color-mix(in srgb, var(--hero-accent) 4%, transparent);
		opacity: .92;
		pointer-events: none;
	}

	.hero-object-halo::before,
	.hero-object-halo::after {
		content: '';
		position: absolute;
		border: 1px dashed color-mix(in srgb, var(--hero-foreground) 24%, transparent);
		border-radius: 50%;
		pointer-events: none;
	}

	.hero-object-halo::before {
		inset: 12%;
	}

	.hero-object-halo::after {
		inset: -18%;
		border-color: color-mix(in srgb, var(--hero-accent) 24%, transparent);
	}

	.hero-object :global(img) {
		position: relative;
		z-index: 1;
		width: 100%;
		height: min(68vh, 700px);
		object-fit: contain;
		filter: drop-shadow(0 32px 28px rgba(0,0,0,.32));
		animation: collection-float 6s ease-in-out infinite;
	}

	.collection-hero-slide.is-orbital .hero-object-halo {
		border-radius: 0;
		border-color: color-mix(in srgb, var(--hero-signal) 34%, transparent);
		clip-path: polygon(0 0, 90% 0, 100% 10%, 100% 100%, 10% 100%, 0 90%);
		transform: rotate(-4deg);
	}

	.collection-hero-slide.is-orbital .hero-object-halo::before,
	.collection-hero-slide.is-orbital .hero-object-halo::after {
		border-radius: 0;
	}

	.collection-hero-slide.is-orbital .hero-object :global(img) {
		height: auto;
		max-height: min(54vh, 520px);
		border: 1px solid color-mix(in srgb, var(--hero-signal) 32%, transparent);
		border-radius: 4px;
		object-fit: cover;
		clip-path: polygon(0 0, 94% 0, 100% 14%, 100% 100%, 6% 100%, 0 86%);
		filter: drop-shadow(0 32px 30px rgba(0,0,0,.52));
	}

	.hero-object-caption {
		position: absolute;
		right: 2%;
		bottom: 12%;
		z-index: 2;
		display: block;
		padding: 12px 16px;
		border-left: 2px solid var(--hero-accent);
		background: color-mix(in srgb, var(--hero-background) 82%, transparent);
		color: var(--hero-foreground);
		backdrop-filter: blur(14px);
	}

	.hero-object-caption b,
	.hero-object-caption small {
		display: block;
		line-height: 1.4;
	}

	.hero-object-caption b {
		font-size: 13px;
		font-family: var(--font-medium);
	}

	.hero-object-caption small {
		color: var(--hero-muted);
		font-size: 10px;
		letter-spacing: 1px;
	}

	.hero-controls {
		position: absolute;
		z-index: 12;
		right: max(40px, calc((100vw - 1500px) / 2 + 40px));
		bottom: 88px;
		display: flex;
		align-items: center;
		gap: 16px;
		width: min(48vw, 760px);
		min-height: 38px;
		padding: 0;
		background: transparent;
		color: #fff;
		text-shadow: 0 1px 8px rgba(0,0,0,.42);
	}

	.hero-controls button {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		padding: 0;
		border: 1px solid rgba(255,255,255,.26);
		border-radius: 50%;
		background: rgba(4,8,12,.14);
		color: #fff;
		font-size: 17px;
		cursor: pointer;
		box-shadow: 0 1px 10px rgba(0,0,0,.14);
		backdrop-filter: blur(6px);
		transition: background .2s ease, border-color .2s ease;
	}

	.hero-controls button:hover,
	.hero-controls button:focus-visible {
		border-color: var(--color-main);
		background: var(--color-main);
	}

	.hero-progress {
		flex: 1;
		width: auto;
		height: 1px;
		overflow: hidden;
		background: rgba(255,255,255,.32);
		box-shadow: 0 1px 4px rgba(0,0,0,.2);
	}

	.hero-progress i {
		display: block;
		width: 100%;
		height: 100%;
		background: #fff;
		transform: scaleX(0);
		transform-origin: left;
	}

	.hero-progress i.is-running {
		animation: hero-progress 9s linear forwards;
	}

	.hero-controls > span {
		font-size: 11px;
		font-family: var(--font-light);
		letter-spacing: 1px;
	}

	.hero-controls > span b {
		font-size: 15px;
		font-family: var(--font-medium);
	}

	.hero-scroll {
		position: absolute;
		z-index: 14;
		left: 50%;
		bottom: 26px;
		display: flex;
		align-items: center;
		gap: 12px;
		color: #383b40;
		text-decoration: none;
		transform: translateX(-50%);
		transition: color .2s ease, transform .2s ease;
	}

	.hero-scroll:hover,
	.hero-scroll:focus-visible {
		color: var(--color-main);
		transform: translate(-50%, 2px);
	}

	.scroll-mouse {
		position: relative;
		display: block;
		width: 24px;
		height: 38px;
		border: 1.5px solid currentColor;
		border-radius: 14px;
	}

	.scroll-mouse i {
		position: absolute;
		left: 50%;
		top: 7px;
		width: 3px;
		height: 7px;
		border-radius: 999px;
		background: currentColor;
		transform: translateX(-50%);
		animation: scroll-wheel 1.8s cubic-bezier(.45,0,.2,1) infinite;
	}

	.scroll-label {
		display: flex;
		flex-direction: column;
		gap: 1px;
		line-height: 1.2;
	}

	.scroll-label b {
		font-size: 9px;
		font-family: var(--font-medium);
		letter-spacing: 2px;
	}

	.scroll-label small {
		color: var(--grey-5);
		font-size: 9px;
		font-family: var(--font-light);
	}

	.collection-categories,
	.all-collections {
		width: min(1500px, 100%);
		margin: 0 auto;
		padding: 116px 20px 20px;
	}

	.section-heading {
		margin-bottom: 44px;
	}

	.section-heading p {
		margin: 0 0 8px;
		color: var(--color-main);
		font-size: 12px;
		font-family: var(--font-light);
		letter-spacing: 2.4px;
		text-transform: uppercase;
	}

	.section-heading h2 {
		margin: 0;
		color: var(--grey-8);
		font-size: clamp(3rem, 6vw, 6.2rem);
		font-family: var(--font-heavy);
		letter-spacing: -.07em;
		line-height: .95;
	}

	.section-heading > span {
		display: block;
		margin-top: 15px;
		color: var(--grey-5);
		font-size: 15px;
		font-family: var(--font-light);
	}

	.section-heading.is-row {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 24px;
	}

	.section-heading.is-row > span {
		margin: 0 0 8px;
		padding: 7px 14px;
		border: 1px solid var(--color-red-a3);
		border-radius: 999px;
		color: var(--color-main);
		font-family: var(--font-medium);
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		grid-auto-rows: 420px;
		gap: 18px;
	}

	.category-card {
		position: relative;
		display: block;
		grid-column: span 5;
		padding: 30px;
		overflow: hidden;
		border-radius: 10px;
		background: var(--category-soft);
		color: var(--category-foreground);
		text-decoration: none;
		isolation: isolate;
	}

	.category-card:first-child {
		grid-column: span 7;
	}

	.category-card:nth-child(3) {
		grid-column: span 5;
	}

	.category-card:nth-child(4) {
		grid-column: span 7;
	}

	.category-card::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -2;
		background: linear-gradient(135deg, var(--category-background), var(--category-background-alt));
	}

	.category-card::after {
		content: '';
		position: absolute;
		inset: 14px;
		z-index: 3;
		border: 1px solid rgba(255,255,255,.16);
		border-radius: 5px;
		pointer-events: none;
	}

	.category-card.is-violet::before {
		background: linear-gradient(145deg, var(--category-background), var(--category-background-alt));
	}

	.category-card.is-sage::before {
		background: linear-gradient(120deg, var(--category-background), var(--category-background-alt));
	}

	.category-card.is-orbital::before {
		background:
			linear-gradient(var(--category-grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--category-grid) 1px, transparent 1px),
			radial-gradient(circle at 72% 30%, var(--category-background-alt), transparent 48%),
			var(--category-background);
		background-size: 42px 42px, 42px 42px, auto, auto;
	}

	.category-number {
		position: absolute;
		top: 28px;
		right: 30px;
		font-size: 12px;
		font-family: var(--font-light);
		letter-spacing: 1px;
	}

	.category-copy {
		position: relative;
		z-index: 2;
		display: block;
		max-width: 53%;
	}

	.category-copy small,
	.category-copy strong,
	.category-copy > span {
		display: block;
	}

	.category-copy small {
		margin-bottom: 10px;
		font-size: 10px;
		font-family: var(--font-light);
		letter-spacing: 2px;
	}

	.category-copy strong {
		font-size: clamp(2rem, 4vw, 4rem);
		font-family: var(--font-heavy);
		letter-spacing: -.06em;
		line-height: 1;
	}

	.category-copy > span {
		margin-top: 18px;
		color: var(--category-muted);
		font-size: 13px;
		font-family: var(--font-light);
		line-height: 1.75;
	}

	.category-card :global(img) {
		position: absolute;
		right: -4%;
		bottom: -13%;
		z-index: 1;
		width: 60%;
		height: 92%;
		object-fit: contain;
		filter: drop-shadow(0 22px 22px rgba(0,0,0,.28));
		transition: transform .5s cubic-bezier(.2,.8,.2,1);
	}

	.category-card:nth-child(2) :global(img) {
		right: -12%;
		width: 70%;
	}

	.category-card.is-orbital :global(img) {
		right: -2%;
		bottom: 8%;
		width: 65%;
		height: 64%;
		border: 1px solid color-mix(in srgb, var(--category-signal) 34%, transparent);
		border-radius: 4px;
		object-fit: cover;
		clip-path: polygon(0 0, 94% 0, 100% 16%, 100% 100%, 6% 100%, 0 84%);
	}

	.category-count {
		position: absolute;
		left: 30px;
		bottom: 26px;
		z-index: 2;
		font-size: 10px;
		font-family: var(--font-medium);
		letter-spacing: 1.5px;
	}

	.category-card > i {
		position: absolute;
		right: 30px;
		bottom: 25px;
		z-index: 4;
		font-size: 24px;
		font-style: normal;
		transition: transform .25s ease;
	}

	.category-card:hover :global(img),
	.category-card:focus-visible :global(img) {
		transform: scale(1.06) translateY(-8px);
	}

	.category-card:hover > i,
	.category-card:focus-visible > i {
		transform: translate(4px, -4px);
	}

	.all-collections {
		padding-top: 140px;
		padding-bottom: 76px;
	}

	.collection-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 54px 20px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@keyframes collection-float {
		0%, 100% { transform: translateY(0) rotate(.3deg); }
		50% { transform: translateY(-16px) rotate(-.6deg); }
	}

	@keyframes hero-glitch-media {
		0% { clip-path: inset(0 0 78% 0); transform: translateX(16px) scale(1.025); opacity: .12; filter: saturate(1.8) contrast(1.24) hue-rotate(22deg); }
		9% { clip-path: inset(19% 0 54% 0); transform: translateX(-13px) scale(1.02); opacity: .58; }
		18% { clip-path: inset(62% 0 16% 0); transform: translateX(10px) scale(1.018); filter: saturate(.35) contrast(1.5); }
		29% { clip-path: inset(7% 0 67% 0); transform: translateX(-6px) scale(1.012); opacity: .34; }
		41% { clip-path: inset(38% 0 29% 0); transform: translateX(4px) scale(1.008); filter: saturate(1.15) contrast(1.12); }
		58%, 100% { clip-path: inset(0); transform: none; opacity: .42; filter: saturate(.82) contrast(1.05); }
	}

	@keyframes hero-glitch-scan {
		0%, 6%, 20%, 34%, 48%, 100% { opacity: 0; transform: translateX(0); }
		7%, 19% { opacity: .88; transform: translateX(9%); }
		21%, 33% { opacity: .46; transform: translateX(-12%); }
		35%, 47% { opacity: .28; transform: translateX(4%); }
	}

	@keyframes hero-glitch-code {
		0%, 6%, 20%, 36%, 56%, 100% { opacity: 0; transform: translateX(16px); }
		7%, 19% { opacity: .92; transform: translateX(-7px); }
		21%, 35% { opacity: .45; transform: translateX(5px); }
		37%, 55% { opacity: .72; transform: none; }
	}

	@keyframes module-chip-in {
		from { opacity: 0; transform: translateX(-28px); clip-path: inset(0 100% 0 0); }
		to { opacity: 1; transform: none; clip-path: inset(0); }
	}

	@keyframes module-archive-in {
		from { opacity: 0; transform: translateX(-18px); filter: blur(5px); }
		to { opacity: 1; transform: none; filter: none; }
	}

	@keyframes module-title-in {
		from { opacity: 0; transform: translateX(-38px) skewX(-3deg); filter: blur(3px); }
		to { opacity: 1; transform: none; filter: none; }
	}

	@keyframes module-tags-in {
		from { opacity: 0; transform: translateY(13px); }
		to { opacity: 1; transform: none; }
	}

	@keyframes module-info-in {
		from { opacity: 0; transform: translateX(24px); clip-path: polygon(0 0, 0 0, 0 100%, 0 100%); }
		to { opacity: 1; transform: none; clip-path: polygon(0 0, 100% 0, calc(100% - var(--info-slope-shift, 72px)) 100%, 0 100%); }
	}

	@keyframes module-object-in {
		from { opacity: 0; transform: translateX(30px) scale(.965); filter: blur(4px); }
		to { opacity: 1; transform: none; filter: none; }
	}

	@keyframes module-caption-in {
		from { opacity: 0; transform: translateY(14px); }
		to { opacity: 1; transform: none; }
	}

	@keyframes hero-progress {
		to { transform: scaleX(1); }
	}

	@keyframes archive-scroll-left {
		to { transform: translateX(-50%); }
	}

	@keyframes archive-scroll-right {
		from { transform: translateX(-50%); }
		to { transform: translateX(0); }
	}

	@keyframes scroll-wheel {
		0% {
			opacity: 0;
			transform: translate(-50%, 0);
		}
		20% {
			opacity: 1;
		}
		72% {
			opacity: 1;
			transform: translate(-50%, 12px);
		}
		100% {
			opacity: 0;
			transform: translate(-50%, 15px);
		}
	}

	@media only screen and (max-width: 980px) {
		.collection-hero {
			min-height: 760px;
		}

		.hero-motion-type {
			top: 132px;
			width: 52vw;
			height: 220px;
		}

		.hero-copy-stack {
			grid-column: 1 / span 8;
		}

		.hero-title {
			font-size: clamp(4.4rem, 10vw, 7rem);
		}

		.hero-controls {
			width: min(52vw, 600px);
		}

		.hero-scroll {
			left: 47%;
		}

		.category-grid {
			grid-auto-rows: 370px;
		}

		.category-card,
		.category-card:first-child,
		.category-card:nth-child(3),
		.category-card:nth-child(4) {
			grid-column: span 6;
		}

		.collection-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media only screen and (max-width: 720px) {
		.collection-hero {
			--hero-header-offset: 62px;
			--hero-mobile-inset: 12px;
			--hero-mobile-content-inset: clamp(22px, 6vw, 28px);
			--hero-mobile-stage-left: clamp(62px, 18vw, 82px);
			--hero-mobile-menu-height: 46px;
			--hero-mobile-stage-reserve: var(--hero-mobile-menu-height);
			--hero-mobile-top: clamp(10px, 2vh, 18px);
			--hero-mobile-top: clamp(10px, 2svh, 18px);
			--hero-mobile-copy-bottom: var(--hero-mobile-menu-height);
			height: calc(100vh - var(--hero-header-offset));
			height: calc(100svh - var(--hero-header-offset));
			min-height: 0;
			max-height: calc(100svh - var(--hero-header-offset));
			margin-top: var(--hero-header-offset);
			overflow: hidden;
		}

		.collection-hero::after {
			content: '';
			position: absolute;
			z-index: 11;
			right: 15px;
			bottom: var(--hero-mobile-menu-height);
			left: 15px;
			height: 1px;
			background: linear-gradient(90deg, color-mix(in srgb, var(--grey-6) 44%, transparent), color-mix(in srgb, var(--grey-5) 18%, transparent));
			pointer-events: none;
		}

		.hero-backdrop,
		.hero-grid {
			top: var(--hero-mobile-top);
			left: var(--hero-mobile-stage-left);
			right: var(--hero-mobile-inset);
			bottom: var(--hero-mobile-stage-reserve);
			width: auto;
			height: auto;
			min-height: 0;
			clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%);
		}

		.hero-backdrop::after {
			background:
				linear-gradient(180deg, rgba(4,8,12,.02) 0 38%, color-mix(in srgb, var(--hero-background) 22%, transparent) 64%, color-mix(in srgb, var(--hero-background) 78%, transparent) 100%),
				linear-gradient(90deg, color-mix(in srgb, var(--hero-background) 28%, transparent), transparent 68%);
		}

		.hero-inner {
			display: block;
			padding: 0;
		}

		.hero-eyebrow {
			position: absolute;
			top: var(--hero-mobile-top);
			left: var(--hero-mobile-inset);
			min-height: 34px;
			padding-right: 14px;
			font-size: 9px;
		}

		.hero-eyebrow::before {
			width: 24px;
		}

		.hero-object {
			position: absolute;
			top: var(--hero-mobile-top);
			right: var(--hero-mobile-inset);
			bottom: var(--hero-mobile-stage-reserve);
			left: var(--hero-mobile-stage-left);
			min-height: 0;
			padding: clamp(42px, 6svh, 58px) 8px clamp(36px, 5svh, 50px) 8%;
		}

		.hero-object :global(img) {
			width: min(76vw, 380px);
			height: min(42svh, 350px);
			max-height: calc(100% - 70px);
		}

		.collection-hero-slide.is-orbital .hero-object :global(img) {
			width: min(74vw, 370px);
			height: auto;
			max-height: min(33svh, 280px);
		}

		.hero-object-halo {
			z-index: 0;
			width: min(62vw, 270px);
			border-color: color-mix(in srgb, var(--hero-foreground) 56%, transparent);
			box-shadow:
				0 0 0 28px color-mix(in srgb, var(--hero-accent) 10%, transparent),
				0 0 0 58px color-mix(in srgb, var(--hero-accent) 6%, transparent);
			opacity: .82;
		}

		.hero-copy-stack {
			position: absolute;
			right: calc(var(--hero-mobile-inset) + 5%);
			bottom: var(--hero-mobile-copy-bottom);
			left: 15px;
			align-items: flex-start;
			gap: clamp(5px, 1svh, 9px);
			width: auto;
			height: auto;
			min-height: 0;
			--hero-optical-indent: 8px;
		}

		.hero-motion-type {
			display: none;
		}

		.hero-meta-stack {
			gap: clamp(5px, .8svh, 8px);
			min-height: 0;
			transform: none;
		}

		.hero-info-panel {
			align-self: stretch;
			width: min(100%, 34rem);
			max-height: 108px;
			padding: clamp(8px, 1.2svh, 11px) 34px clamp(8px, 1.2svh, 10px) 14px;
			border-top: 1px solid color-mix(in srgb, var(--hero-accent) 20%, transparent);
			background: linear-gradient(105deg, #fff 0 74%, rgba(255,255,255,.9) 100%);
			box-shadow: 0 14px 28px rgba(20,24,30,.06);
			backdrop-filter: none;
			--info-slope-shift: 16px;
		}

		.hero-subtitle {
			overflow: hidden;
			font-size: 9px;
			line-height: 1.35;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.hero-summary {
			display: -webkit-box;
			overflow: hidden;
			margin-top: 5px;
			max-width: min(72vw, 30rem);
			font-size: clamp(10px, 2.7vw, 12px);
			line-height: 1.45;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 2;
		}

		.hero-link {
			margin-top: 6px;
			font-size: 10px;
		}

		.hero-tags {
			align-self: flex-start;
			flex-wrap: nowrap;
			gap: 5px;
			width: min(100%, 34rem);
			max-width: 100%;
			overflow: hidden;
		}

		.hero-tags span {
			flex: 0 0 auto;
			padding: 4px 8px;
			font-size: 9px;
		}

		.hero-title {
			align-self: stretch;
			width: calc(100% - 4px);
