---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getCollectionCategory, getCollectionCategoryHref } from '../../data/collectionCategories';
import { getCollectionAsset } from '../../lib/collectionAssets';
import { isContentEnabled } from '../../lib/contentVisibility';

export async function getStaticPaths() {
	const items = await getCollection('collections');
	return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props as { item: CollectionEntry<'collections'> };
const { Content } = await item.render();
const category = getCollectionCategory(item.data.category);
const image = getCollectionAsset(item.data.imageKey);
const isProductShowcase = item.data.presentation === 'product';
const heroMediaSource = item.data.heroMedia?.src?.startsWith('asset:')
	? getCollectionAsset(item.data.heroMedia.src.slice(6)).src
	: item.data.heroMedia?.src;
const acquiredDate = item.data.acquiredAt.toLocaleDateString('zh-CN', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
const allItems = (await getCollection('collections')).filter(isContentEnabled);
const relatedItems = allItems.filter((entry) => entry.data.category === item.data.category && entry.slug !== item.slug).slice(0, 3);
---

<Layout webTitle={`MOEGN 收藏 - ${item.data.title}`} noIndex={item.data.disable}>
	<main
		class:list={{ 'is-product-page': isProductShowcase }}
		style={`--item-accent: ${category?.accent ?? '#ff69b4'}; --item-soft: ${category?.softAccent ?? '#ffe6fa'}; --item-background: ${category?.background ?? '#181518'}; --item-background-alt: ${category?.backgroundAlt ?? '#33202a'}; --item-foreground: ${category?.foreground ?? '#ffffff'}; --item-muted: ${category?.muted ?? '#c8bfc4'}; --item-signal: ${category?.signal ?? '#ff69b4'}; --item-grid: ${category?.grid ?? '#ffffff'};`}
	>
		<nav class="detail-breadcrumb" aria-label="当前位置">
			<a href="/collections/">收藏室</a><span>/</span>
			{category ? <><a href={getCollectionCategoryHref(category.slug)}>{category.title}</a><span>/</span></> : null}
			<span>{item.data.title}</span>
		</nav>

		<section class:list={['detail-hero', { 'is-product': isProductShowcase }]}>
			{isProductShowcase && heroMediaSource ? (
				<img class="detail-hero-media" src={heroMediaSource} alt="" style={`object-position: ${item.data.heroMedia?.position ?? 'center'};`} />
			) : null}
			<div class="detail-copy">
				<p class="detail-kicker">MOEGN PRIVATE COLLECTION · {category?.index ?? '00'}</p>
				<div class="detail-tags">
					<span>{item.data.itemType === 'virtual' ? '虚拟藏品' : '实体收藏'}</span>
					{item.data.tags.map((tag) => <span>{tag}</span>)}
				</div>
				<h1>{item.data.title}</h1>
				<p class="detail-subtitle">{item.data.subTitle}</p>
				<p class="detail-summary">{item.data.summary}</p>
				{isProductShowcase && item.data.sourceLinks.length ? (
					<div class="detail-product-actions">
						{item.data.sourceLinks.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label}<span aria-hidden="true">↗</span></a>)}
					</div>
				) : null}
			</div>
			<div class="detail-object">
				<span class="object-ring" aria-hidden="true"></span>
				<Image src={image} alt={item.data.title} loading="eager" />
			</div>
			<span class="detail-number" aria-hidden="true">{category?.index ?? '00'}</span>
		</section>

		{isProductShowcase && item.data.specs.length ? (
			<section class="product-spec-strip" aria-label="产品规格">
				{item.data.specs.map((spec, index) => (
					<div><small>{String(index + 1).padStart(2, '0')} / {spec.label}</small><strong>{spec.value}<i>{spec.unit}</i></strong></div>
				))}
			</section>
		) : null}

		<section class="detail-record" aria-label="收藏档案">
			<div class="record-heading"><p>Object Record</p><h2>藏品<br />档案</h2></div>
			<dl>
				<div><dt>收藏日期</dt><dd>{acquiredDate}</dd></div>
				<div><dt>收藏形态</dt><dd>{item.data.itemType === 'virtual' ? '虚拟物品' : '现实藏品'}</dd></div>
				{item.data.maker ? <div><dt>创作者 / 品牌</dt><dd>{item.data.maker}</dd></div> : null}
				{item.data.edition ? <div><dt>版本</dt><dd>{item.data.edition}</dd></div> : null}
			</dl>
		</section>

		{isProductShowcase && (item.data.gallery.length || item.data.modules.length) ? (
			<section class="product-showcase" aria-label={`${item.data.title} 产品展示`}>
				<header class="product-showcase-heading">
					<div><p>CONFIGURE THE MISSION</p><h2>一副舰体，<br />多种任务。</h2></div>
					<p>银河的模块化中段把职业能力变成可替换的产品组件；固定舰体负责航行、生活与后部机库，任务模块决定每一次出航的身份。</p>
				</header>

				{item.data.gallery.length ? (
					<div class="product-gallery">
						{item.data.gallery.map((galleryItem, index) => (
							<figure class:list={{ 'is-primary': index === 0 }}>
								<img src={galleryItem.src} alt={galleryItem.alt} loading={index === 0 ? 'eager' : 'lazy'} />
								{galleryItem.caption ? <figcaption><span>{String(index + 1).padStart(2, '0')}</span>{galleryItem.caption}</figcaption> : null}
							</figure>
						))}
					</div>
				) : null}

				{item.data.modules.length ? (
					<div class="product-modules" aria-label="任务模块">
						{item.data.modules.map((module, index) => (
							<article>
								<span>{String(index + 1).padStart(2, '0')}</span>
								<small>{module.kicker}</small>
								<h3>{module.title}</h3>
								<p>{module.summary}</p>
							</article>
						))}
					</div>
				) : null}
			</section>
		) : null}

		<article class="detail-article">
			<header><p>Collection Notes</p><h2>收藏<br />手记</h2></header>
			<div class="article-body"><Content /></div>
		</article>

		{isProductShowcase && item.data.legalNotice ? (
			<p class="product-legal-notice">{item.data.legalNotice}</p>
		) : null}

		{relatedItems.length ? (
			<section class="related-items">
				<header><p>Same Chapter</p><h2>同类收藏</h2></header>
				<ul role="list">
					{relatedItems.map((related) => {
						const relatedImage = getCollectionAsset(related.data.imageKey);
						return (
							<li><a href={`/collections/${related.slug}/`}>
								<span><Image src={relatedImage} alt={related.data.title} loading="lazy" /></span>
								<strong>{related.data.title}</strong><small>{related.data.subTitle}</small>
							</a></li>
						);
					})}
				</ul>
			</section>
		) : null}
	</main>
</Layout>

<style>
	main {
		width: min(1500px, 100%);
		margin: 0 auto;
		padding: 104px 20px 76px;
	}

	.detail-breadcrumb {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
		margin-bottom: 18px;
		color: var(--grey-5);
		font-size: 13px;
		font-family: var(--font-light);
	}

	.detail-breadcrumb a {
		color: var(--item-accent);
		text-decoration: none;
	}

	.detail-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, .95fr) minmax(400px, 1.05fr);
		align-items: center;
		min-height: 650px;
		padding: clamp(36px, 6vw, 84px);
		overflow: hidden;
		border-radius: 10px;
		background: linear-gradient(130deg, #181518, color-mix(in srgb, var(--item-accent) 72%, #181518));
		box-shadow: 0 26px 56px color-mix(in srgb, var(--item-accent) 18%, transparent);
		color: #fff;
	}

	.detail-hero.is-product {
		background:
			linear-gradient(var(--item-grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--item-grid) 1px, transparent 1px),
			linear-gradient(130deg, var(--item-background), var(--item-background-alt));
		background-size: 56px 56px, 56px 56px, auto;
		color: var(--item-foreground);
	}

	.detail-hero.is-product::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(90deg, rgba(3, 12, 19, .96) 0%, rgba(3, 12, 19, .7) 45%, rgba(3, 12, 19, .28) 100%);
	}

	.detail-hero-media {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: .55;
		filter: saturate(.74) contrast(1.12);
	}

	.detail-hero::after {
		content: '';
		position: absolute;
		inset: 18px;
		border: 1px solid rgba(255,255,255,.15);
		border-radius: 5px;
		pointer-events: none;
	}

	.detail-copy,
	.detail-object {
		position: relative;
		z-index: 2;
	}

	.detail-kicker {
		margin: 0 0 20px;
		color: var(--item-soft);
		font-size: 11px;
		font-family: var(--font-light);
		letter-spacing: 2px;
	}

	.detail-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 18px;
	}

	.detail-tags span {
		padding: 5px 10px;
		border: 1px solid rgba(255,255,255,.22);
		border-radius: 999px;
		background: rgba(255,255,255,.08);
		font-size: 11px;
		line-height: 1;
	}

	.detail-copy h1 {
		margin: 0;
		font-size: clamp(3.4rem, 7vw, 7.4rem);
		font-family: var(--font-heavy);
		letter-spacing: -.075em;
		line-height: .91;
	}

	.detail-subtitle {
		margin: 18px 0 0;
		color: var(--item-soft);
		font-size: 12px;
		font-family: var(--font-medium);
		letter-spacing: 2px;
	}

	.detail-summary {
		max-width: 620px;
		margin: 22px 0 0;
		color: rgba(255,255,255,.7);
		font-size: 16px;
		font-family: var(--font-light);
		line-height: 1.85;
	}

	.detail-product-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 28px;
	}

	.detail-product-actions a {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		min-height: 40px;
		padding: 0 15px;
		border: 1px solid color-mix(in srgb, var(--item-signal) 46%, transparent);
		border-radius: 3px;
		background: color-mix(in srgb, var(--item-background) 74%, transparent);
		color: var(--item-foreground);
		font-size: 11px;
		font-family: var(--font-medium);
		text-decoration: none;
		clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
		transition: background .2s ease, color .2s ease;
	}

	.detail-product-actions a:hover,
	.detail-product-actions a:focus-visible {
		background: var(--item-signal);
		color: var(--item-background);
	}

	.detail-object {
		display: grid;
		place-items: center;
		height: 100%;
		min-height: 470px;
	}

	.object-ring {
		position: absolute;
		width: min(34vw, 500px);
		aspect-ratio: 1;
		border: 1px solid rgba(255,255,255,.18);
		border-radius: 50%;
		box-shadow: 0 0 0 40px rgba(255,255,255,.025), 0 0 0 82px rgba(255,255,255,.016);
	}

	.detail-object :global(img) {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 550px;
		object-fit: contain;
		filter: drop-shadow(0 30px 26px rgba(0,0,0,.36));
	}

	.detail-hero.is-product .object-ring {
		border-radius: 4px;
		border-color: color-mix(in srgb, var(--item-signal) 34%, transparent);
		clip-path: polygon(0 0, 90% 0, 100% 10%, 100% 100%, 10% 100%, 0 90%);
		transform: rotate(-4deg);
	}

	.detail-hero.is-product .detail-object :global(img) {
		height: auto;
		max-height: 410px;
		border: 1px solid color-mix(in srgb, var(--item-signal) 32%, transparent);
		border-radius: 4px;
		object-fit: cover;
		clip-path: polygon(0 0, 94% 0, 100% 14%, 100% 100%, 6% 100%, 0 86%);
		filter: drop-shadow(0 30px 26px rgba(0,0,0,.54));
	}

	.detail-number {
		position: absolute;
		right: -3%;
		bottom: -20%;
		z-index: 0;
		color: rgba(255,255,255,.045);
		font-size: clamp(17rem, 34vw, 32rem);
		font-family: var(--font-heavy);
		letter-spacing: -.12em;
		line-height: .8;
	}

	.product-spec-strip {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		margin-top: 14px;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--item-signal) 28%, transparent);
		border-radius: 5px;
		background: var(--item-background);
		color: var(--item-foreground);
	}

	.product-spec-strip div {
		position: relative;
		padding: 22px 24px 20px;
		border-right: 1px solid color-mix(in srgb, var(--item-grid) 68%, transparent);
	}

	.product-spec-strip div:last-child {
		border-right: 0;
	}

	.product-spec-strip small,
	.product-spec-strip strong {
		display: block;
	}

	.product-spec-strip small {
		color: var(--item-muted);
		font-size: 9px;
		font-family: var(--font-light);
		letter-spacing: 1.5px;
	}

	.product-spec-strip strong {
		margin-top: 6px;
		font-size: clamp(2rem, 4vw, 3.9rem);
		font-family: var(--font-heavy);
		line-height: 1;
	}

	.product-spec-strip strong i {
		margin-left: 5px;
		color: var(--item-signal);
		font-size: 11px;
		font-family: var(--font-medium);
		font-style: normal;
		letter-spacing: 1px;
	}

	.detail-record,
	.detail-article {
		display: grid;
		grid-template-columns: minmax(220px, .42fr) minmax(0, 1fr);
		gap: clamp(38px, 8vw, 130px);
		padding: 112px 5%;
	}

	.record-heading p,
	.detail-article header p,
	.related-items header p {
		margin: 0 0 8px;
		color: var(--item-accent);
		font-size: 11px;
		font-family: var(--font-light);
		letter-spacing: 2px;
	}

	.record-heading h2,
	.detail-article header h2,
	.related-items header h2 {
		margin: 0;
		font-size: clamp(2.8rem, 5vw, 5.2rem);
		font-family: var(--font-heavy);
		letter-spacing: -.07em;
		line-height: .95;
	}

	.detail-record dl {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0 38px;
		margin: 0;
	}

	.detail-record dl div {
		padding: 20px 0;
		border-bottom: 1px solid color-mix(in srgb, var(--item-accent) 20%, white);
	}

	.detail-record dt {
		margin-bottom: 6px;
		color: var(--grey-5);
		font-size: 12px;
		font-family: var(--font-light);
	}

	.detail-record dd {
		margin: 0;
		color: var(--grey-8);
		font-size: 17px;
		font-family: var(--font-medium);
	}

	.product-showcase {
		position: relative;
		padding: clamp(34px, 5vw, 72px);
		overflow: hidden;
		border-radius: 10px;
		background:
			linear-gradient(color-mix(in srgb, var(--item-grid) 55%, transparent) 1px, transparent 1px),
			linear-gradient(90deg, color-mix(in srgb, var(--item-grid) 55%, transparent) 1px, transparent 1px),
			radial-gradient(circle at 80% 20%, var(--item-background-alt), transparent 38%),
			var(--item-background);
		background-size: 54px 54px, 54px 54px, auto, auto;
		color: var(--item-foreground);
	}

	.product-showcase::after {
		content: '';
		position: absolute;
		inset: 16px;
		border: 1px solid color-mix(in srgb, var(--item-signal) 24%, transparent);
		border-radius: 5px;
		pointer-events: none;
	}

	.product-showcase-heading {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: minmax(300px, .8fr) minmax(0, 1fr);
		gap: 60px;
		align-items: end;
		margin-bottom: 48px;
	}

	.product-showcase-heading > div > p {
		margin: 0 0 10px;
		color: var(--item-signal);
		font-size: 10px;
		font-family: var(--font-light);
		letter-spacing: 2.5px;
	}

	.product-showcase-heading h2 {
		margin: 0;
		font-size: clamp(3rem, 6vw, 6.2rem);
		font-family: var(--font-heavy);
		letter-spacing: -.07em;
		line-height: .92;
	}

	.product-showcase-heading > p {
		max-width: 620px;
		margin: 0 0 5px;
		color: var(--item-muted);
		font-size: 15px;
		font-family: var(--font-light);
		line-height: 1.9;
	}

	.product-gallery {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.product-gallery figure {
		position: relative;
		margin: 0;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--item-signal) 25%, transparent);
		border-radius: 4px;
		background: #02070a;
		clip-path: polygon(0 0, 96% 0, 100% 12%, 100% 100%, 4% 100%, 0 88%);
	}

	.product-gallery figure.is-primary {
		grid-column: 1 / -1;
	}

	.product-gallery img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 7;
		object-fit: cover;
		transition: transform .6s cubic-bezier(.2,.8,.2,1), filter .4s ease;
	}

	.product-gallery figure:not(.is-primary) img {
		aspect-ratio: 16 / 8;
	}

	.product-gallery figure:hover img {
		transform: scale(1.025);
		filter: saturate(1.16);
	}

	.product-gallery figcaption {
		position: absolute;
		left: 16px;
		bottom: 14px;
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 7px 10px;
		background: rgba(3,12,19,.74);
		color: var(--item-foreground);
		font-size: 9px;
		font-family: var(--font-medium);
		letter-spacing: 1.4px;
		backdrop-filter: blur(10px);
	}

	.product-gallery figcaption span {
		color: var(--item-signal);
	}

	.product-modules {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
		margin-top: 54px;
	}

	.product-modules article {
		position: relative;
		min-height: 280px;
		padding: 30px;
		border: 1px solid color-mix(in srgb, var(--item-grid) 74%, transparent);
		background: color-mix(in srgb, var(--item-background-alt) 34%, transparent);
		clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 24px 100%, 0 calc(100% - 24px));
	}

	.product-modules article > span {
		position: absolute;
		right: 24px;
		top: 18px;
		color: color-mix(in srgb, var(--item-signal) 35%, transparent);
		font-size: 4rem;
		font-family: var(--font-heavy);
		line-height: 1;
	}

	.product-modules small {
		position: relative;
		z-index: 1;
		color: var(--item-signal);
		font-size: 9px;
		letter-spacing: 1.5px;
	}

	.product-modules h3 {
		position: relative;
		z-index: 1;
		margin: 52px 0 15px;
		font-size: 2.5rem;
		font-family: var(--font-heavy);
		line-height: 1;
	}

	.product-modules p {
		position: relative;
		z-index: 1;
		margin: 0;
		color: var(--item-muted);
		font-size: 13px;
		font-family: var(--font-light);
		line-height: 1.8;
	}

	.detail-article {
		padding-top: 94px;
		border-top: 1px solid color-mix(in srgb, var(--item-accent) 20%, white);
	}

	.article-body {
		max-width: 780px;
		color: var(--grey-7);
		font-size: 17px;
		line-height: 2;
	}

	.article-body :global(h2) {
		margin: 2.1em 0 .55em;
		color: var(--grey-8);
		font-size: 2rem;
		font-family: var(--font-heavy);
		line-height: 1.25;
	}

	.article-body :global(h2:first-child) {
		margin-top: 0;
	}

	.article-body :global(p) {
		margin: 0 0 1.2em;
	}

	.product-legal-notice {
		margin: -54px 5% 80px calc(5% + min(220px, 22vw) + clamp(38px, 8vw, 130px));
		padding-top: 18px;
		border-top: 1px solid color-mix(in srgb, var(--item-accent) 20%, white);
		color: var(--grey-5);
		font-size: 11px;
		font-family: var(--font-light);
		line-height: 1.75;
	}

	.related-items {
		padding: 90px 0 20px;
		border-top: 1px solid color-mix(in srgb, var(--item-accent) 20%, white);
	}

	.related-items header {
		margin-bottom: 38px;
	}

	.related-items ul {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

