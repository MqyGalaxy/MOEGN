---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import CollectionItemCard from '../../../components/CollectionItemCard.astro';
import Layout from '../../../layouts/Layout.astro';
import { collectionCategories, type CollectionCategory } from '../../../data/collectionCategories';
import { getCollectionAsset } from '../../../lib/collectionAssets';
import { isContentEnabled } from '../../../lib/contentVisibility';

export function getStaticPaths() {
	return collectionCategories.map((category) => ({
		params: { slug: category.slug },
		props: { category },
	}));
}

const { category } = Astro.props as { category: CollectionCategory };
const items = (await getCollection('collections'))
	.filter(isContentEnabled)
	.filter((item) => item.data.category === category.slug)
	.sort((left, right) => right.data.acquiredAt.valueOf() - left.data.acquiredAt.valueOf());
const featuredItem = items.find((item) => item.data.featured) ?? items[0];
const featuredImage = featuredItem ? getCollectionAsset(featuredItem.data.imageKey) : null;
---

<Layout webTitle={`MOEGN 收藏 - ${category.title}`}>
	<main style={`--category-accent: ${category.accent}; --category-soft: ${category.softAccent}; --category-background: ${category.background}; --category-background-alt: ${category.backgroundAlt}; --category-foreground: ${category.foreground}; --category-muted: ${category.muted}; --category-signal: ${category.signal}; --category-grid: ${category.grid};`}>
		<nav class="category-breadcrumb" aria-label="当前位置">
			<a href="/collections/">收藏室</a><span>/</span><span>{category.title}</span>
		</nav>

		<section class:list={['category-hero', `is-${category.tone}`]}>
			<div class="category-index" aria-hidden="true">{category.index}</div>
			<div class="category-copy">
				<p>{category.englishTitle}</p>
				<h1>{category.title}</h1>
				<p class="category-description">{category.description}</p>
				<div class="category-stat"><b>{String(items.length).padStart(2, '0')}</b><span>COLLECTED ITEMS</span></div>
			</div>
			{featuredImage ? (
				<div class="category-object">
					<span aria-hidden="true"></span>
					<Image src={featuredImage} alt={featuredItem?.data.title ?? category.title} loading="eager" />
				</div>
			) : null}
			<div class="category-signature">MOEGN<br />PRIVATE COLLECTION</div>
		</section>

		<section class="category-intro" aria-label="分类说明">
			<p>CHAPTER {category.index}</p>
			<h2>物品会变化，<br />被留下的理由不会。</h2>
			<div>
				<p>{category.description}</p>
				<p>这里的每一件记录都连接到一篇站内收藏文章，保存它的版本、来历、状态，以及无法写进参数表的私人记忆。</p>
			</div>
		</section>

		<section class="category-items" aria-labelledby="category-items-title">
			<header>
				<div><p>Chapter Inventory</p><h2 id="category-items-title">分类藏品</h2></div>
				<a href="/collections/#collection-categories">查看其他分类 ↗</a>
			</header>
			{items.length ? (
				<ul role="list">
					{items.map((item, index) => <li><CollectionItemCard item={item} priority={index < 2} /></li>)}
				</ul>
			) : <p class="category-empty">这个章节正在等待它的第一件收藏。</p>}
		</section>
	</main>
</Layout>

<style>
	main {
		width: min(1500px, 100%);
		margin: 0 auto;
		padding: 104px 20px 70px;
		color: var(--grey-7);
	}

	.category-breadcrumb {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 18px;
		color: var(--grey-5);
		font-size: 13px;
		font-family: var(--font-light);
	}

	.category-breadcrumb a {
		color: var(--category-accent);
		text-decoration: none;
	}

	.category-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, .9fr) minmax(360px, 1.1fr);
		align-items: center;
		min-height: 610px;
		padding: clamp(34px, 6vw, 82px);
		overflow: hidden;
		border-radius: 10px;
		background: linear-gradient(135deg, var(--category-background), var(--category-background-alt));
		color: var(--category-foreground);
		isolation: isolate;
	}

	.category-hero::before {
		content: '';
		position: absolute;
		inset: 18px;
		z-index: 3;
		border: 1px solid rgba(255,255,255,.16);
		border-radius: 5px;
		pointer-events: none;
	}

	.category-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		opacity: .14;
		background-image:
			linear-gradient(rgba(255,255,255,.3) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255,255,255,.3) 1px, transparent 1px);
		background-size: 64px 64px;
		mask-image: linear-gradient(90deg, transparent, #000);
	}

	.category-hero.is-violet {
		background: linear-gradient(145deg, var(--category-background), var(--category-background-alt));
	}

	.category-hero.is-sage {
		background: linear-gradient(125deg, var(--category-background), var(--category-background-alt));
	}

	.category-hero.is-orbital {
		background:
			radial-gradient(circle at 72% 32%, var(--category-background-alt), transparent 48%),
			linear-gradient(125deg, var(--category-background), color-mix(in srgb, var(--category-background-alt) 78%, black));
	}

	.category-hero.is-orbital::after {
		opacity: .36;
		background-image:
			linear-gradient(var(--category-grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--category-grid) 1px, transparent 1px);
		background-size: 48px 48px;
		mask-image: linear-gradient(90deg, transparent 5%, #000 45%, #000);
	}

	.category-index {
		position: absolute;
		right: -2vw;
		bottom: -14%;
		z-index: -1;
		color: rgba(255,255,255,.055);
		font-size: clamp(16rem, 35vw, 34rem);
		font-family: var(--font-heavy);
		letter-spacing: -.12em;
		line-height: .8;
	}

	.category-copy {
		position: relative;
		z-index: 2;
	}

	.category-copy > p:first-child {
		margin: 0 0 14px;
		font-size: 11px;
		font-family: var(--font-light);
		letter-spacing: 3px;
	}

	.category-copy h1 {
		margin: 0;
		font-size: clamp(4.4rem, 9vw, 9rem);
		font-family: var(--font-heavy);
		letter-spacing: -.08em;
		line-height: .88;
	}

	.category-description {
		max-width: 460px;
		margin: 26px 0 0;
		color: var(--category-muted);
		font-size: 16px;
		font-family: var(--font-light);
		line-height: 1.8;
	}

	.category-stat {
		display: flex;
		align-items: baseline;
		gap: 12px;
		margin-top: 36px;
	}

	.category-stat b {
		font-size: 2.2rem;
		font-family: var(--font-heavy);
		line-height: 1;
	}

	.category-stat span {
		font-size: 9px;
		letter-spacing: 1.5px;
	}

	.category-object {
		position: relative;
		display: grid;
		place-items: center;
		height: 100%;
		min-height: 450px;
	}

	.category-object > span {
		position: absolute;
		width: min(32vw, 460px);
		aspect-ratio: 1;
		border: 1px solid rgba(255,255,255,.2);
		border-radius: 50%;
		box-shadow: 0 0 0 34px rgba(255,255,255,.025), 0 0 0 70px rgba(255,255,255,.018);
	}

	.category-object :global(img) {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 520px;
		object-fit: contain;
		filter: drop-shadow(0 28px 24px rgba(0,0,0,.36));
	}

	.category-hero.is-orbital .category-object > span {
		border-radius: 4px;
		border-color: color-mix(in srgb, var(--category-signal) 35%, transparent);
		clip-path: polygon(0 0, 90% 0, 100% 10%, 100% 100%, 10% 100%, 0 90%);
		transform: rotate(-4deg);
	}

	.category-hero.is-orbital .category-object :global(img) {
		height: auto;
		max-height: 390px;
		border: 1px solid color-mix(in srgb, var(--category-signal) 32%, transparent);
		border-radius: 4px;
		object-fit: cover;
		clip-path: polygon(0 0, 94% 0, 100% 14%, 100% 100%, 6% 100%, 0 86%);
		filter: drop-shadow(0 30px 28px rgba(0,0,0,.52));
	}

	.category-signature {
		position: absolute;
		right: 38px;
		bottom: 34px;
		z-index: 4;
		color: rgba(255,255,255,.55);
		font-size: 8px;
		font-family: var(--font-light);
		letter-spacing: 1.6px;
		line-height: 1.5;
		text-align: right;
	}

	.category-intro {
		display: grid;
		grid-template-columns: .42fr .9fr 1fr;
		gap: clamp(28px, 5vw, 80px);
		align-items: start;
		padding: 112px 4% 126px;
	}

	.category-intro > p {
		margin: 8px 0 0;
		color: var(--category-accent);
		font-size: 11px;
		font-family: var(--font-light);
		letter-spacing: 2px;
	}

	.category-intro h2 {
		margin: 0;
		color: var(--grey-8);
		font-size: clamp(2.5rem, 5vw, 5.4rem);
		font-family: var(--font-heavy);
		letter-spacing: -.07em;
		line-height: .98;
	}

	.category-intro div p {
		margin: 0 0 18px;
		color: var(--grey-6);
		font-size: 15px;
		font-family: var(--font-light);
		line-height: 1.9;
	}

	.category-items {
		padding-top: 68px;
		border-top: 1px solid color-mix(in srgb, var(--category-accent) 24%, white);
	}

	.category-items header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 42px;
	}

	.category-items header p {
		margin: 0 0 7px;
		color: var(--category-accent);
		font-size: 11px;
		font-family: var(--font-light);
		letter-spacing: 2px;
	}

	.category-items h2 {
		margin: 0;
		font-size: clamp(2.8rem, 5vw, 5rem);
		font-family: var(--font-heavy);
		letter-spacing: -.07em;
		line-height: .95;
	}

	.category-items header a {
		padding-bottom: 4px;
		border-bottom: 1px solid var(--category-accent);
		color: var(--category-accent);
		font-size: 13px;
		font-family: var(--font-medium);
		text-decoration: none;
	}

	.category-items ul {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 50px 20px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.category-empty {
		padding: 64px;
		border-radius: 10px;
		background: var(--category-soft);
		color: var(--category-accent);
		text-align: center;
	}

	@media only screen and (max-width: 900px) {
		.category-hero {
			grid-template-columns: 1fr .8fr;
			min-height: 520px;
		}

		.category-object :global(img) {
			height: 420px;
		}

		.category-intro {
			grid-template-columns: 1fr 1fr;
		}

		.category-intro > p {
			grid-column: 1 / -1;
		}

		.category-items ul {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media only screen and (max-width: 650px) {
		main {
			padding: 88px 12px 54px;
		}

		.category-hero {
			grid-template-columns: 1fr;
			min-height: 650px;
			padding: 40px 28px 28px;
		}

		.category-copy h1 {
			font-size: clamp(3.6rem, 20vw, 6.5rem);
		}

		.category-object {
			min-height: 280px;
		}

		.category-object :global(img) {
			height: 300px;
		}

		.category-signature {
			display: none;
		}

		.category-intro {
			grid-template-columns: 1fr;
			padding: 72px 8px 84px;
		}

		.category-intro > p {
			grid-column: auto;
		}

		.category-items header {
			align-items: flex-start;
			flex-direction: column;
		}

		.category-items ul {
			grid-template-columns: 1fr;
		}
	}
</style>
