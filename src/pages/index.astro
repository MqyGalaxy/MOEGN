---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import HomeContent from '../components/HomeContent.astro';
import LargeCard from '../components/LargeCard.astro';
import mascot from '../images/moegn-hero-standee-transparent.png';
import moegnIcon from '../images/MOEGN-icon@4x.png';

---

<Layout webTitle="MOEGN - 次元之声" headerTheme="hero">
	<div class="page-title" data-hero-animate>
		<div class="hero-stage">
			<div class="hero-title hero-rise">
				<p>MOEGN Review</p>
				<h1>次元<br>之声</h1>
				<span>Anime / Game / Review Archive</span>
				<div class="hero-title-actions">
					<a class="hero-title-button is-solid" href="#reviews">查看评测</a>
					<a class="hero-title-button is-outline" href="/generator/">创建卡片</a>
				</div>
			</div>
			<div class="hero-showcase hero-rise">
				<div class="hero-mascot">
					<Image src={mascot} alt="MOEGN 看板角色" />
				</div>
				<div class="side-wave side-wave-shoe" aria-hidden="true">
					<svg viewBox="0 0 180 32" focusable="false">
						<path d="M0 16 L22 28 L45 16 L68 28 L91 16 L114 28 L137 16 L160 28 L180 16" />
					</svg>
				</div>
				<div class="side-wave side-wave-top" aria-hidden="true">
					<svg viewBox="0 0 180 32" focusable="false">
						<path d="M0 16 L22 28 L45 16 L68 28 L91 16 L114 28 L137 16 L160 28 L180 16" />
					</svg>
				</div>
				<div class="side-wave side-wave-card" aria-hidden="true">
					<svg viewBox="0 0 180 32" focusable="false">
						<path d="M0 16 L22 28 L45 16 L68 28 L91 16 L114 28 L137 16 L160 28 L180 16" />
					</svg>
				</div>
				<div class="side-wave side-wave-hand" aria-hidden="true">
					<svg viewBox="0 0 180 32" focusable="false">
						<path d="M0 16 L22 28 L45 16 L68 28 L91 16 L114 28 L137 16 L160 28 L180 16" />
					</svg>
				</div>
				<div class="mascot-shape shape-circle" aria-hidden="true"><span></span></div>
				<div class="mascot-shape shape-triangle" aria-hidden="true"><span></span></div>
				<div class="mascot-shape shape-square" aria-hidden="true"><span></span></div>
				<div class="page-title-info">
					<LargeCard
						title="说你想说的。";
						subTitle="Say anything that you want to say.";
						score="✓";
						scoreTag="次元之声";
						body="为玩家发出次元之声！MOEGN 始终保持以大众的视角来评测面向大众的作品。这里会保存看过的动漫、玩过的游戏，以及每一次值得留下来的判断。";
						proClass="为玩家：";
						href="https://blog.moeqy.com/acg/game/20240129/post-1/";
						buttonText="插件下载";
						imgSrc={moegnIcon.src};
					>
					</LargeCard>
				</div>
				<a class="page-title-plugin-button" href="#generator">插件下载</a>
			</div>
		</div>
	</div>
	<main>
		<HomeContent />
	</main>
</Layout>

<style>
	main {
		display: flex;
		justify-content: center;
		align-items: center;
		width: 100%;
		margin: 0;
		padding: 0;
		color: var(--text-color);
		font-size: 20px;
		line-height: 1.6;
	}

	.page-title {
		position: relative;
		display: flex;
		justify-content: center;
		align-items: stretch;
		height: 100vh;
		height: 100svh;
		max-height: 100vh;
		max-height: 100svh;
		padding: 90px 20px 0;
		background: linear-gradient(120deg, var(--color-main) 0, var(--color-light) 100%);
		overflow: hidden;
	}

	.page-title::after {
		content: '';
		position: absolute;
		z-index: 3;
		left: 50%;
		bottom: 0;
		width: 150%;
		height: 100px;
		border-radius: 100%;
		background: var(--grey-1);
		transform: translate(-50%, 50%);
	}

	.side-wave {
		position: absolute;
		z-index: 1;
		width: clamp(116px, 11vw, 170px);
		pointer-events: none;
		animation: side-wave-float 6.8s ease-in-out infinite;
	}

	.side-wave-shoe {
		left: 14%;
		top: 30%;
	}

	.side-wave-top {
		right: 20%;
		top: 12%;
		scale: -1 1; 
		animation-delay: -2.2s;
	}

	.side-wave-card {
		right: 1%;
		bottom: 50%;
		animation-delay: -1.1s;
	}

	.side-wave-hand {
		right: 12%;
		bottom: 10%;
		scale: -1 1; 
		animation-delay: -3.2s;
	}

	.side-wave svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
		transform: rotate(90deg);
		transform-origin: center;
	}

	.side-wave path {
		fill: none;
		stroke: var(--grey-1-a7);
		stroke-width: 9;
		stroke-linecap: square;
		stroke-linejoin: miter;
	}

	.hero-stage {
		position: relative;
		z-index: 4;
		display: grid;
		grid-template-columns: minmax(280px, .62fr) minmax(620px, 1.38fr);
		align-items: center;
		width: min(1500px, 100%);
		height: calc(100vh - 90px);
		height: calc(100svh - 90px);
		min-height: 0;
		margin: 0 auto;
		overflow: hidden;
	}

	.hero-rise {
		opacity: 0;
		transform: translate3d(0, 88px, 0);
		will-change: opacity, transform;
	}

	.page-title.is-hero-ready .hero-rise {
		animation: hero-rise-up 1.1s cubic-bezier(.18, .82, .22, 1) forwards;
	}

	.hero-showcase.hero-rise {
		animation-delay: .16s;
	}

	.hero-title {
		position: relative;
		z-index: 7;
		align-self: start;
		padding-top: 36px;
		color: var(--grey-0);
	}

	.hero-title p,
	.hero-title span {
		margin: 0;
		color: var(--grey-1-a7);
		font-family: var(--font-light);
		letter-spacing: 1px;
		line-height: 1.4;
	}

	.hero-title h1 {
		position: relative;
		z-index: 2;
		margin: 10px 0;
		font-size: clamp(4rem, 8.4vw, 9rem);
		font-family: var(--font-heavy);
		line-height: .92;
	}

	.hero-title-actions {
		position: relative;
		z-index: 8;
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 24px;
	}

	.hero-title-button {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 132px;
		min-height: 44px;
		padding: 0 24px;
		border: 2px solid var(--grey-1);
		border-radius: 999px;
		color: var(--grey-0);
		font-size: 15px;
		font-family: var(--font-medium);
		line-height: 1;
		text-decoration: none;
		transition: transform .2s ease, background .2s ease, color .2s ease, box-shadow .2s ease;
	}

	.hero-title-button:hover {
		transform: translateY(-2px);
	}

	.hero-title-button.is-solid {
		background: var(--grey-1);
		color: var(--color-main);
		box-shadow: 0 12px 24px var(--grey-9-a1);
	}

	.hero-title-button.is-outline {
		background: transparent;
	}

	.hero-showcase {
		position: relative;
		align-self: stretch;
		justify-self: end;
		width: min(68vw, 980px);
		height: 100%;
		min-height: 0;
		pointer-events: none;
	}

	.hero-mascot {
		position: absolute;
		z-index: 2;
		right: 0;
		bottom: 58px;
		width: min(66vw, 940px);
		max-height: min(82vh, 800px);
		max-height: min(82svh, 800px);
	}

	.hero-mascot img {
		width: 100%;
		height: auto;
		max-height: min(82vh, 800px);
		max-height: min(82svh, 800px);
		object-fit: contain;
		object-position: bottom right;
		filter: drop-shadow(0 24px 34px rgba(173, 39, 101, 0.22));
		animation: mascot-float 5.8s ease-in-out infinite;
	}

	.mascot-shape {
		position: absolute;
		z-index: 3;
		--shape-scale: 1;
		pointer-events: none;
		animation: mascot-float 5.8s ease-in-out infinite;
	}

	.mascot-shape span {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--grey-1-a7);
		filter: drop-shadow(0 10px 16px rgba(173, 39, 101, 0.14));
		animation: shape-spin 8s linear infinite;
	}

	.shape-circle {
		top: 23%;
		right: 13%;
		width: 44px;
		height: 44px;
		animation-delay: -.8s;
	}

	.shape-circle span {
		border-radius: 50%;
	}

	.shape-triangle {
		top: 38%;
		left: 16%;
		width: 56px;
		height: 50px;
		animation-delay: -1.8s;
	}

	.shape-triangle span {
		clip-path: polygon(50% 0, 100% 100%, 0 100%);
	}

	.shape-square {
		right: 5%;
		bottom: 24%;
		width: 46px;
		height: 46px;
		animation-delay: -2.6s;
	}

	.shape-square span {
		border-radius: 8px;
	}

	.page-title-info {
		position: absolute;
		z-index: 2;
		left: 2%;
		bottom: 74px;
		width: min(760px, 70%);
		pointer-events: auto;
	}

	.page-title-plugin-button {
		position: absolute;
		z-index: 999;
		left: 50%;
		bottom: 30px;
		display: none;
		align-items: center;
		justify-content: center;
		min-width: 132px;
		min-height: 44px;
		padding: 0 24px;
		border-radius: 999px;
		background: linear-gradient(120deg, var(--color-main) 0, var(--color-light) 100%);
		color: var(--grey-0);
		font-size: 15px;
		font-family: var(--font-medium);
		line-height: 1;
		text-decoration: none;
		box-shadow: 0 0 24px var(--grey-1);
		transform: translateX(-50%);
		pointer-events: auto;
		transition: transform .2s ease, box-shadow .2s ease;
	}

	.page-title-plugin-button:hover {
		transform: translate(-50%, -2px);
		box-shadow: 0 0 24px var(--grey-1);
	}

	@media only screen and (max-width: 980px) {
		.hero-stage {
			grid-template-columns: 1fr;
			grid-template-rows: auto minmax(0, 1fr);
		}

		.hero-title {
			padding-top: 18px;
			text-align: center;
		}

		.hero-showcase {
			justify-self: center;
			width: min(100%, 720px);
			height: 100%;
			min-height: 0;
		}

		.hero-mascot {
			right: 50%;
			bottom: 58px;
			width: min(92vw, 620px);
			max-height: 52vh;
			max-height: 52svh;
			transform: translateX(50%);
		}

		.hero-mascot img {
			max-height: 52vh;
			max-height: 52svh;
			object-position: bottom center;
		}

		.page-title-info {
			display: none;
		}

		.page-title-plugin-button {
			display: inline-flex;
		}

		.side-wave {
			width: clamp(82px, 14vw, 120px);
			opacity: .66;
		}

		.side-wave-shoe {
			left: 14%;
			top: 30%;
		}

		.side-wave-top {
			right: 20%;
			top: 12%;
		}

		.side-wave-card {
			left: 38%;
			bottom: 24%;
		}

		.side-wave-hand {
			right: 12%;
			bottom: 10%;
		}

		.hero-title-actions {
			justify-content: center;
		}

		.shape-circle {
			right: 10%;
		}

		.shape-triangle {
			left: 8%;
		}

		.shape-square {
			right: 4%;
			bottom: 26%;
		}
	}

	@media only screen and (max-width: 720px) {
		main {
			align-items: flex-start;
		}

		.page-title {
			padding: 70px 12px 0;
		}

		.hero-title h1 {
			font-size: clamp(3.2rem, 16vw, 5rem);
		}

		.page-title-info {
			display: none;
		}

		.side-wave {
			display: none;
		}

		.hero-title-actions {
			gap: 10px;
			margin-top: 18px;
		}

		.hero-title-button {
			min-width: 118px;
			min-height: 40px;
			padding: 0 18px;
			font-size: 14px;
		}

		.page-title-plugin-button {
			bottom: 10px;
			min-width: 118px;
			min-height: 40px;
			padding: 0 20px;
			font-size: 14px;
		}

		.mascot-shape {
			--shape-scale: .78;
		}
	}

	@media only screen and (min-width: 721px) and (max-height: 560px) {
		.hero-mascot {
			display: none;
		}
	}

	@media only screen and (max-height: 560px) {
		.hero-mascot {
			display: none;
		}
	}

	@media only screen and (max-height: 720px) {
		.hero-mascot {
			max-height: 40vh;
			max-height: 40svh;
		}

		.hero-mascot img {
			max-height: 40vh;
			max-height: 40svh;
			object-position: bottom center;
		}
	}

	@media only screen and (max-height: 600px) {
		.hero-mascot {
			max-height: 30vh;
			max-height: 30svh;
		}

		.hero-mascot img {
			max-height: 30vh;
			max-height: 30svh;
			object-position: bottom center;
		}
	}


	@keyframes side-wave-float {
		0%,
		100% {
			transform: translate3d(0, 0, 0);
		}

		50% {
			transform: translate3d(0, -18px, 0);
		}
	}

	@keyframes mascot-float {
		0%,
		100% {
			transform: translate3d(0, 0, 0) scale(var(--shape-scale, 1));
		}

		50% {
			transform: translate3d(0, -16px, 0) scale(var(--shape-scale, 1));
		}
	}

	@keyframes shape-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@keyframes hero-rise-up {
		to {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-rise,
		.side-wave svg,
		.hero-mascot img,
		.mascot-shape,
		.mascot-shape span {
			animation: none;
		}

		.hero-rise {
			opacity: 1;
			transform: none;
		}
	}
</style>

<script>
const hero = document.querySelector("[data-hero-animate]");

const waitForWindowLoad = () => new Promise<void>((resolve) => {
	if (document.readyState === "complete") {
		resolve();
		return;
	}

	window.addEventListener("load", () => resolve(), { once: true });
});

const waitForFonts = () => {
	if ("fonts" in document) {
		return document.fonts.ready;
	}

	return Promise.resolve();
};

Promise.all([waitForWindowLoad(), waitForFonts()]).then(() => {
	window.requestAnimationFrame(() => {
		hero?.classList.add("is-hero-ready");
	});
});
</script>
