</style>

<script>
	const root = document.querySelector<HTMLElement>('[data-collection-hero]');

	if (root) {
		root.classList.add('is-initializing');
		const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-collection-slide]'));
		const previousButton = root.querySelector<HTMLButtonElement>('[data-hero-prev]');
		const nextButton = root.querySelector<HTMLButtonElement>('[data-hero-next]');
		const currentLabel = root.querySelector<HTMLElement>('[data-hero-current]');
		const progress = root.querySelector<HTMLElement>('[data-hero-progress]');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const order = slides.map((_, index) => index);
		let position = 0;
		let timer: number | undefined;
		let pointerStartX: number | null = null;
		let geometryFrame: number | undefined;
		let geometrySettleFrame: number | undefined;
		let fontsReady = document.fonts.status === 'loaded';

		type LayoutBox = { left: number; top: number; width: number; height: number; right: number; bottom: number };

		const getLayoutBox = (element: HTMLElement, ancestor: HTMLElement): LayoutBox | null => {
			let left = 0;
			let top = 0;
			let node: HTMLElement | null = element;

			while (node && node !== ancestor) {
				left += node.offsetLeft;
				top += node.offsetTop;
				node = node.offsetParent as HTMLElement | null;
			}

			if (node !== ancestor) return null;
			const width = element.offsetWidth;
			const height = element.offsetHeight;
			return { left, top, width, height, right: left + width, bottom: top + height };
		};

		const syncSlideGeometry = (slide: HTMLElement) => {
			const mobile = window.matchMedia('(max-width: 720px)').matches;
			const compactLandscape = window.matchMedia('(orientation: landscape) and (max-width: 960px) and (max-height: 520px)').matches;
			const compactHero = mobile || compactLandscape;
			const backdrop = slide.querySelector<HTMLElement>('.hero-backdrop');
			const title = slide.querySelector<HTMLElement>('.hero-title');
			const infoPanel = slide.querySelector<HTMLElement>('.hero-info-panel');
			const metaStack = slide.querySelector<HTMLElement>('.hero-meta-stack');
			if (!backdrop || !title) return;

			const backdropBox = getLayoutBox(backdrop, slide);
			const titleBox = getLayoutBox(title, slide);
			if (!backdropBox || !titleBox || !backdropBox.width || !backdropBox.height || !titleBox.width || !titleBox.height) return;

			const edgeTopRatio = mobile ? .18 : compactLandscape ? .22 : .49;
			const edgeBottomRatio = compactHero ? 0 : .14;

			if (infoPanel) {
				const panelBox = getLayoutBox(infoPanel, slide);
				if (panelBox) {
					const slopeRatio = backdropBox.width * (edgeTopRatio - edgeBottomRatio) / backdropBox.height;
					const shift = Math.min(panelBox.width * .3, panelBox.height * slopeRatio);
					infoPanel.style.setProperty('--info-slope-shift', `${Math.max(0, shift)}px`);
				}
			}

			if (metaStack) {
				const metaBox = getLayoutBox(metaStack, slide);
				const drop = compactHero || !metaBox ? 0 : Math.max(0, Math.min(36, backdropBox.bottom - metaBox.bottom));
				metaStack.style.setProperty('--hero-meta-drop', `${drop}px`);
			}

			if (!fontsReady) {
				title.classList.remove('is-mask-ready');
				return;
			}

			const edgeAt = (layoutY: number) => {
				const progress = Math.min(1, Math.max(0, (layoutY - backdropBox.top) / backdropBox.height));
				const edgeRatio = edgeTopRatio + (edgeBottomRatio - edgeTopRatio) * progress;
				return backdropBox.left + backdropBox.width * edgeRatio - titleBox.left;
			};

			const topEdge = edgeAt(titleBox.top);
			const bottomEdge = edgeAt(titleBox.bottom);
			const deltaX = bottomEdge - topEdge;
			const normalLength = Math.hypot(titleBox.height, -deltaX);
			const normalX = titleBox.height / normalLength;
			const normalY = -deltaX / normalLength;
			const angle = Math.atan2(normalX, -normalY) * 180 / Math.PI;
			const halfGradientLength = (Math.abs(titleBox.width * normalX) + Math.abs(titleBox.height * normalY)) / 2;
			const boundaryProjection = (topEdge - titleBox.width / 2) * normalX - (titleBox.height / 2) * normalY;
			const stop = Math.min(100, Math.max(0, ((boundaryProjection + halfGradientLength) / (halfGradientLength * 2)) * 100));

			title.style.setProperty('--title-mask-angle', `${angle}deg`);
			title.style.setProperty('--title-mask-stop', `${stop}%`);
			title.classList.add('is-mask-ready');
		};

		const getActiveSlide = () => slides[order[position]];

		const requestGeometrySync = (slide = getActiveSlide()) => {
			if (!slide) return;
			window.cancelAnimationFrame(geometryFrame ?? 0);
			window.cancelAnimationFrame(geometrySettleFrame ?? 0);
			geometryFrame = window.requestAnimationFrame(() => {
				geometrySettleFrame = window.requestAnimationFrame(() => syncSlideGeometry(slide));
			});
		};

		for (let index = order.length - 1; index > 0; index -= 1) {
			const randomIndex = Math.floor(Math.random() * (index + 1));
			[order[index], order[randomIndex]] = [order[randomIndex], order[index]];
		}

		const setVideoState = (slide: HTMLElement, active: boolean) => {
			const video = slide.querySelector<HTMLVideoElement>('[data-hero-video]');
			if (!video) return;
			if (active) {
				video.play().catch(() => undefined);
			} else {
				video.pause();
			}
		};

		const restartProgress = () => {
			if (!progress || reducedMotion || slides.length < 2) return;
			progress.classList.remove('is-running');
			void progress.offsetWidth;
			progress.classList.add('is-running');
		};

		const show = (nextPosition: number) => {
			if (!slides.length) return;
			position = (nextPosition + order.length) % order.length;
			const activeIndex = order[position];
			const activeSlide = slides[activeIndex];
			if (activeSlide) syncSlideGeometry(activeSlide);
			slides.forEach((slide, index) => {
				const active = index === activeIndex;
				slide.classList.toggle('is-active', active);
				slide.setAttribute('aria-hidden', String(!active));
				setVideoState(slide, active);
			});
			if (currentLabel) currentLabel.textContent = String(position + 1).padStart(2, '0');
			if (activeSlide) requestGeometrySync(activeSlide);
			restartProgress();
		};

		const schedule = () => {
			window.clearTimeout(timer);
			if (slides.length > 1 && !reducedMotion) {
				timer = window.setTimeout(() => {
					show(position + 1);
					schedule();
				}, 9000);
			}
		};

		previousButton?.addEventListener('click', () => { show(position - 1); schedule(); });
		nextButton?.addEventListener('click', () => { show(position + 1); schedule(); });
		root.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') {
				show(position - 1);
				schedule();
			}
			if (event.key === 'ArrowRight') {
				show(position + 1);
				schedule();
			}
		});
		root.addEventListener('pointerdown', (event) => {
			pointerStartX = event.clientX;
		});
		root.addEventListener('pointerup', (event) => {
			if (pointerStartX === null) return;
			const distance = event.clientX - pointerStartX;
			pointerStartX = null;
			if (Math.abs(distance) < 54) return;
			show(position + (distance < 0 ? 1 : -1));
			schedule();
		});
		root.addEventListener('pointercancel', () => { pointerStartX = null; });
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) {
				window.clearTimeout(timer);
				const activeSlide = slides[order[position]];
				if (activeSlide) setVideoState(activeSlide, false);
			} else {
				show(position);
				schedule();
			}
		});
		const geometryObserver = typeof ResizeObserver === 'undefined'
			? null
			: new ResizeObserver(() => requestGeometrySync());
		geometryObserver?.observe(root);
		slides.forEach((slide) => {
			const title = slide.querySelector<HTMLElement>('.hero-title');
			const backdrop = slide.querySelector<HTMLElement>('.hero-backdrop');
			if (title) geometryObserver?.observe(title);
			if (backdrop) geometryObserver?.observe(backdrop);
		});

		window.addEventListener('resize', () => requestGeometrySync(), { passive: true });
		window.addEventListener('orientationchange', () => requestGeometrySync(), { passive: true });
		document.fonts.ready.then(() => {
			fontsReady = true;
			requestGeometrySync();
		});
		show(0);
		window.requestAnimationFrame(() => {
			window.requestAnimationFrame(() => root.classList.remove('is-initializing'));
		});
		schedule();
	}
</script>
