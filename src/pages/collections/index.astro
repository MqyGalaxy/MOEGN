	@media (prefers-reduced-motion: reduce) {
		.collection-hero-slide,
		.hero-backdrop::before,
		.hero-backdrop img,
		.hero-backdrop video,
		.hero-glitch-code,
		.hero-eyebrow,
		.hero-motion-type,
		.hero-title,
		.hero-tags,
		.hero-info-panel,
		.hero-object,
		.hero-object-caption,
