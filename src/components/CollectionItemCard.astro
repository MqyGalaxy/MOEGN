---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCollectionCategory } from '../data/collectionCategories';
import { getCollectionAsset } from '../lib/collectionAssets';

interface Props {
	item: CollectionEntry<'collections'>;
	priority?: boolean;
}

const { item, priority = false } = Astro.props;
const category = getCollectionCategory(item.data.category);
const image = getCollectionAsset(item.data.imageKey);
---

<a
	class:list={['collection-item-card', category ? `is-${category.tone}` : null]}
	href={`/collections/${item.slug}/`}
	style={`--item-accent: ${category?.accent ?? '#ff69b4'}; --item-soft: ${category?.softAccent ?? '#ffe6fa'};`}
	aria-label={`查看收藏 ${item.data.title}`}
>
	<span class="collection-item-visual">
		<Image src={image} alt={item.data.title} loading={priority ? 'eager' : 'lazy'} />
		<span class="collection-item-type">{item.data.itemType === 'virtual' ? 'VIRTUAL' : 'PHYSICAL'}</span>
	</span>
	<span class="collection-item-copy">
		<small>{category?.title ?? item.data.category}</small>
		<strong>{item.data.title}</strong>
		<span>{item.data.tags.slice(0, 3).join(' · ')}</span>
	</span>
	<span class="collection-item-arrow" aria-hidden="true">↗</span>
</a>

<style>
	.collection-item-card {
		position: relative;
		display: block;
		min-width: 0;
		color: var(--grey-7);
		text-decoration: none;
	}

	.collection-item-visual {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 340px;
		padding: 32px;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--item-accent) 18%, white);
		border-radius: 10px;
		background:
			radial-gradient(circle at 68% 20%, color-mix(in srgb, var(--item-soft) 78%, white), transparent 48%),
			linear-gradient(145deg, #fff, color-mix(in srgb, var(--item-soft) 62%, white));
		transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s ease;
	}

	.collection-item-visual::after {
		content: '';
		position: absolute;
		left: 18%;
		right: 18%;
		bottom: 11%;
		height: 7%;
		border-radius: 50%;
		background: color-mix(in srgb, var(--item-accent) 22%, transparent);
		filter: blur(14px);
	}

	.collection-item-visual :global(img) {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 270px;
		object-fit: contain;
		filter: drop-shadow(0 22px 18px rgba(37, 27, 32, .2));
		transition: transform .45s cubic-bezier(.2,.8,.2,1);
	}

	.collection-item-type {
		position: absolute;
		top: 16px;
		left: 16px;
		z-index: 2;
		padding: 4px 9px;
		border: 1px solid color-mix(in srgb, var(--item-accent) 28%, white);
		border-radius: 999px;
		background: rgba(255,255,255,.72);
		color: var(--item-accent);
		font-size: 10px;
		font-family: var(--font-medium);
		letter-spacing: 1.5px;
		line-height: 1.2;
		backdrop-filter: blur(8px);
	}

	.collection-item-copy {
		display: block;
		padding: 18px 2px 0;
	}

	.collection-item-copy small,
	.collection-item-copy span {
		display: block;
		color: var(--grey-5);
		font-size: 12px;
		font-family: var(--font-light);
		line-height: 1.5;
	}

	.collection-item-copy small {
		margin-bottom: 5px;
		color: var(--item-accent);
		letter-spacing: 1px;
	}

	.collection-item-copy strong {
		display: block;
		margin-bottom: 7px;
		font-size: clamp(1.2rem, 2vw, 1.55rem);
		font-family: var(--font-heavy);
		line-height: 1.3;
	}

	.collection-item-arrow {
		position: absolute;
		right: 3px;
		bottom: 28px;
		color: var(--item-accent);
		font-size: 22px;
		line-height: 1;
		transition: transform .25s ease;
	}

	.collection-item-card:hover .collection-item-visual,
	.collection-item-card:focus-visible .collection-item-visual {
		transform: translateY(-5px);
		box-shadow: 0 22px 42px color-mix(in srgb, var(--item-accent) 15%, transparent);
	}

	.collection-item-card:hover .collection-item-visual :global(img),
	.collection-item-card:focus-visible .collection-item-visual :global(img) {
		transform: scale(1.045) rotate(-1deg);
	}

	.collection-item-card:hover .collection-item-arrow,
	.collection-item-card:focus-visible .collection-item-arrow {
		transform: translate(3px, -3px);
	}

	.collection-item-card:focus-visible {
		outline: 2px solid var(--item-accent);
		outline-offset: 6px;
		border-radius: 10px;
	}

	.collection-item-card.is-orbital .collection-item-visual {
		border-color: color-mix(in srgb, var(--item-accent) 38%, #152c3b);
		background:
			linear-gradient(rgba(88, 213, 255, .08) 1px, transparent 1px),
			linear-gradient(90deg, rgba(88, 213, 255, .08) 1px, transparent 1px),
			radial-gradient(circle at 72% 18%, #173d55, transparent 52%),
			#06121c;
		background-size: 34px 34px, 34px 34px, auto, auto;
	}

	.collection-item-card.is-orbital .collection-item-visual :global(img) {
		width: calc(100% + 24px);
		height: 250px;
		border: 1px solid rgba(88, 213, 255, .22);
		border-radius: 4px;
		object-fit: cover;
		clip-path: polygon(0 0, 93% 0, 100% 13%, 100% 100%, 7% 100%, 0 87%);
		filter: drop-shadow(0 22px 20px rgba(0,0,0,.44));
	}

	.collection-item-card.is-orbital .collection-item-type {
		border-color: rgba(88, 213, 255, .35);
		background: rgba(6,18,28,.78);
		color: #58d5ff;
	}

	@media only screen and (max-width: 720px) {
		.collection-item-visual {
			min-height: 290px;
		}

		.collection-item-visual :global(img) {
			height: 230px;
		}
	}
</style>
